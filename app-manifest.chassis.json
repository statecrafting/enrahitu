{
  "app": { "name": "enrahitu", "org": "statecrafting" },
  "capabilities": [
    {
      "id": "cap.counter.rate-limit.add",
      "kind": "counter.add",
      "resource": "counters",
      "constraints": { "keyPrefix": "rl:" }
    },
    {
      "id": "cap.counter.rate-limit.delete",
      "kind": "counter.delete",
      "resource": "counters",
      "constraints": { "keyPrefix": "rl:" }
    },
    { "id": "cap.db.app.migrate", "kind": "db.migrate", "resource": "app" },
    { "id": "cap.db.app.read", "kind": "db.read", "resource": "app" },
    { "id": "cap.db.app.txn", "kind": "db.txn", "resource": "app" },
    { "id": "cap.db.app.write", "kind": "db.write", "resource": "app" },
    { "id": "cap.db.state.migrate", "kind": "db.migrate", "resource": "state" },
    { "id": "cap.db.state.read", "kind": "db.read", "resource": "state" },
    { "id": "cap.db.state.txn", "kind": "db.txn", "resource": "state" },
    { "id": "cap.db.state.write", "kind": "db.write", "resource": "state" },
    { "id": "cap.lock.state.acquire", "kind": "lock.acquire", "resource": "state" },
    { "id": "cap.notify.state.listen", "kind": "notify.listen", "resource": "state" },
    { "id": "cap.notify.state.publish", "kind": "notify.publish", "resource": "state" },
    { "id": "cap.backup.state.list", "kind": "bucket.list", "resource": "state-backups" },
    { "id": "cap.backup.state.write", "kind": "bucket.write", "resource": "state-backups" },
    { "id": "cap.egress.rauthy-issuer", "kind": "http.egress", "resource": "rauthy-issuer" },
    { "id": "cap.egress.rauthy-upstream", "kind": "http.egress", "resource": "rauthy-upstream" },
    { "id": "cap.secret.jwt-private", "kind": "secret.read", "resource": "jwt_private_key" },
    { "id": "cap.secret.jwt-public", "kind": "secret.read", "resource": "jwt_public_key" },
    {
      "id": "cap.secret.jwt-refresh-private",
      "kind": "secret.read",
      "resource": "jwt_refresh_private_key"
    },
    {
      "id": "cap.secret.jwt-refresh-public",
      "kind": "secret.read",
      "resource": "jwt_refresh_public_key"
    },
    { "id": "cap.secret.rauthy-client", "kind": "secret.read", "resource": "rauthy_client_secret" }
  ],
  "services": {
    "admin": {
      "tier": "ts",
      "capabilities": [
        "cap.db.state.migrate",
        "cap.db.state.read",
        "cap.secret.jwt-public"
      ]
    },
    "control": {
      "tier": "ts",
      "role": "library",
      "capabilities": [
        "cap.db.state.read",
        "cap.db.state.txn",
        "cap.db.state.write",
        "cap.lock.state.acquire",
        "cap.notify.state.listen",
        "cap.notify.state.publish"
      ]
    },
    "auth": {
      "tier": "ts",
      "capabilities": [
        "cap.counter.rate-limit.add",
        "cap.counter.rate-limit.delete",
        "cap.db.app.migrate",
        "cap.db.app.read",
        "cap.db.app.txn",
        "cap.db.app.write",
        "cap.egress.rauthy-issuer",
        "cap.secret.jwt-private",
        "cap.secret.jwt-public",
        "cap.secret.jwt-refresh-private",
        "cap.secret.jwt-refresh-public",
        "cap.secret.rauthy-client"
      ]
    },
    "health": {
      "tier": "ts",
      "capabilities": ["cap.db.app.read"]
    },
    "hiq": { "tier": "ts", "capabilities": [] },
    "idp": {
      "tier": "ts",
      "capabilities": ["cap.egress.rauthy-upstream"]
    },
    "lib": {
      "tier": "ts",
      "role": "library",
      "capabilities": []
    },
    "members": {
      "tier": "ts",
      "capabilities": [
        "cap.db.state.read",
        "cap.db.state.txn",
        "cap.db.state.write",
        "cap.lock.state.acquire",
        "cap.notify.state.listen",
        "cap.notify.state.publish"
      ]
    },
    "obs": {
      "tier": "ts",
      "capabilities": []
    },
    "state": {
      "tier": "ts",
      "role": "library",
      "capabilities": ["cap.db.state.migrate", "cap.db.state.read"]
    },
    "web": {
      "tier": "ts",
      "capabilities": []
    }
  },
  "resources": {
    "counters": [{ "name": "counters" }],
    "databases": [
      { "name": "app", "engine": "coreledger-libsql" },
      { "name": "state", "engine": "hiqlite" }
    ],
    "kv": [{ "name": "cache" }],
    "buckets": [{ "name": "state-backups" }],
    "secrets": [
      { "name": "jwt_private_key" },
      { "name": "jwt_public_key" },
      { "name": "jwt_refresh_private_key" },
      { "name": "jwt_refresh_public_key" },
      { "name": "rauthy_client_secret" }
    ]
  },
  "agents": [],
  "trust": { "levels": ["full", "restricted", "read-only", "suspended"] },
  "gate": { "checks": ["secrets"] },
  "ledger": {
    "recordSchema": "decision/v1",
    "maxRecordBytes": 1024,
    "signing": { "algorithm": "ed25519", "keyEnv": "ENRAHITU_LEDGER_SIGNING_KEY" }
  },
  "observability": { "metricsPath": "/metrics", "otel": true },
  "auth": { "idp": "rauthy-embedded", "operatorRole": "enrahitu_operator" }
}
