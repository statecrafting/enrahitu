# enrahitu: IdP mail delivery (spec 026)
#
# These configure the IdP's outbound mail, which is what makes a second user
# possible: password reset, email verification, registration, and invitation.
# Without them the container still boots and still serves, and the bootstrapped
# admin is the only account anyone can ever sign in as.
#
# Use it as an env file rather than baking values into an image:
#
#   docker run --env-file docker/smtp.env ...
#
# or from a compose service:
#
#   env_file: [docker/smtp.env]
#
# Every variable here is passed through to rauthy inside the entrypoint's rauthy
# subshell, so the application process never sees them. Only variables that are
# SET are passed; leaving one out is not the same as setting it empty, because
# rauthy distinguishes absent from empty for several of them.
#
# ENRAHITU_SMTP_PASSWORD is a secret. It reaches the container through your
# orchestrator's secret mechanism, never through the image and never through a
# file committed to a repository (spec 028).

# --- required to enable mail at all ----------------------------------------
# The relay's hostname. Its presence is what switches delivery on.
ENRAHITU_SMTP_URL=smtp.example.com

# --- the rest are optional and have rauthy's own defaults -------------------
#ENRAHITU_SMTP_PORT=587
#ENRAHITU_SMTP_USERNAME=enrahitu@example.org
#ENRAHITU_SMTP_PASSWORD=change-me
# The From address on everything the IdP sends. Set it to something a recipient
# will recognize; the default is rauthy's, not your association's.
#ENRAHITU_SMTP_FROM=Example Society <noreply@example.org>
# Refuse to fall back to an unencrypted connection.
#ENRAHITU_SMTP_STARTTLS_ONLY=true
# How many times to retry the initial connection before giving up.
#ENRAHITU_SMTP_CONNECT_RETRIES=3
# Allow plaintext SMTP with no TLS. For a relay on a trusted network, or for a
# local mail catcher. Never for a relay reached over the public internet.
#ENRAHITU_SMTP_DANGER_INSECURE=false

# ---------------------------------------------------------------------------
# Worked example 1: an authenticated public relay (the common case)
# ---------------------------------------------------------------------------
# ENRAHITU_SMTP_URL=smtp.postmarkapp.com
# ENRAHITU_SMTP_PORT=587
# ENRAHITU_SMTP_USERNAME=<the provider's token or username>
# ENRAHITU_SMTP_PASSWORD=<the provider's token or password>
# ENRAHITU_SMTP_FROM=Example Society <noreply@example.org>
# ENRAHITU_SMTP_STARTTLS_ONLY=true
#
# ---------------------------------------------------------------------------
# Worked example 2: an unauthenticated internal relay
# ---------------------------------------------------------------------------
# A relay on a private network that accepts mail from inside it and does the
# authenticated hop outward itself. No username, no password, and TLS is
# deliberately not required on a link that never leaves the network.
#
# ENRAHITU_SMTP_URL=mail.internal
# ENRAHITU_SMTP_PORT=25
# ENRAHITU_SMTP_FROM=Example Society <noreply@example.org>
# ENRAHITU_SMTP_DANGER_INSECURE=true
#
# ---------------------------------------------------------------------------
# Not mapped: SMTP_CONN_MODE, SMTP_ROOT_CA, SMTP_XOAUTH, SMTP_OAUTH_TOKEN,
# SMTP_MICROSOFT_GRAPH_URI. rauthy defines them; the table above covers
# password-authenticated and unauthenticated SMTP, which is what a self-hosted
# deployment uses. Graph and XOAUTH are a named extension, mapped on demand,
# not an oversight (spec 026 §5).
# ---------------------------------------------------------------------------
